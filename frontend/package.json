{
  "name": "portfolio-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && node scripts/postbuild.mjs",
    "preview": "serve dist --listen 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run tests/unit",
    "test:seo": "vitest run tests/seo",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:seo && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.0",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "node-html-parser": "^9.0.7",
    "satori": "^0.63.2",
    "serve": "^14.2.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
